#!/bin/bash
#SBATCH --time=720
#SBATCH --job-name=audio-gen
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=10
#SBATCH --nodes=1
#SBATCH --partition=gpu
#SBATCH --mem=24G
#SBATCH --gres=gpu:1
#SBATCH --account=cai_nlp
#SBATCH --mail-user=saaf@zhaw.ch
#SBATCH --output=logs/slurm/%j_%N.out
#SBATCH --error=logs/slurm/%j_%N.err
#SBATCH --open-mode=append

# Text-conditioned latent generator. The VAE checkpoint needs fitted latent statistics
# (train.submit does that after VAE training); override it with VAE_CKPT=<path>.

set -euo pipefail
cd "${SLURM_SUBMIT_DIR:-$(pwd)}"
source scripts/slurm_setup.sh


EXP_NAME="${EXP_NAME:-fm_be}"
RUN_DIR="${RUN_DIR:-logs/train_gen/${EXP_NAME}/runs/$(date +%Y-%m-%d_%H-%M-%S)_${SLURM_JOB_ID:-manual}}"
run mkdir -p "${RUN_DIR}"
echo "[$(date +%T)] gen-train experiment=${EXP_NAME} -> ${RUN_DIR}"

EXTRA=()
if [ -f "${RUN_DIR}/checkpoints/last.pt" ]; then
    EXTRA+=(ckpt_path="${RUN_DIR}/checkpoints/last.pt")
    echo "[$(date +%T)] resuming from ${RUN_DIR}/checkpoints/last.pt"
fi
if [ -n "${VAE_CKPT:-}" ]; then
    EXTRA+=(vae_ckpt="${VAE_CKPT}")
fi

run uv run --no-sync gen-train \
    experiment="${EXP_NAME}" \
    hydra.run.dir="${RUN_DIR}" \
    ${EXTRA[@]+"${EXTRA[@]}"} \
    trainer.device=cuda \
    data.num_workers=8 \
    logger=wandb \
    logger.wandb.id="gen_$(basename "${RUN_DIR}")" \
    "$@"
